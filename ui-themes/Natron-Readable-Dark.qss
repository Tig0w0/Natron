QMenuBar
{
    color: %5;
    background-color: %2;
}

QMenuBar::item
{
    color: %5;
    background-color: %2;
}

QMenuBar::item:selected
{
	color: %5;
    background: %1;
}

QPlainTextEdit {
    color: %5;
    background-color: %3;
    selection-color: %8;
    selection-background-color: %1;
}

OutputScriptTextEdit {
    color: %5;
    background-color: %2;
    selection-color: %8;
    selection-background-color: %1;
}

/*
    Color Selector Button/Widget
*/

QToolButton#ColorSelectorButton {
    border: none;
}

QToolButton#ColorSelectorButton:menu-indicator {
    image: none;
}

QToolButton#ColorSelectorButton:pressed {
    padding-left: 0px;
    top: 0px;
    left: 0px;
}

/* Natron Readable Dark - UI-only overrides, 2026-10-19.
   Keep Natron's original QSS and token substitutions above this block.
   Default accent: desaturated blue-gray; no font files required. */

QWidget {
    color: #e1e6ed;
    background-color: #272c32;
    font-family: "Segoe UI";
}
QLabel, Label {
    color: #e1e6ed;
}
QMainWindow, QDialog {
    background-color: #272c32;
}
QMenuBar {
    color: #e1e6ed;
    background-color: #22272d;
}
QMenuBar::item {
    color: #dce3eb;
    background-color: transparent;
    padding: 4px 7px;
}
QMenuBar::item:selected {
    color: #ffffff;
    background-color: #44586f;
}
QMenu {
    color: #e1e6ed;
    background-color: #2c333b;
    border: 1px solid #73899b;
    padding: 3px;
}
QMenu::item:selected {
    color: #ffffff;
    background-color: #4c657e;
}
QMenu::item:disabled {
    color: #929daa;
}
QPushButton {
    color: #e1e6ed;
    background-color: #373e47;
    border: 1px solid #8294a5;
    border-radius: 3px;
    padding: 4px 7px;
}
QPushButton:hover {
    background-color: #424b55;
    border-color: #a2b6c9;
}
QPushButton:pressed, QPushButton:checked {
    background-color: #334a62;
    border-color: #7598b9;
}
QPushButton:disabled {
    color: #a4adb9;
    background-color: #2a3037;
}
QLineEdit {
    color: #e6edf4;
    background-color: #1d232a;
    border: 1px solid #8499ae;
    border-radius: 3px;
    padding: 3px 5px;
    selection-color: #ffffff;
    selection-background-color: #536f8e;
}
QLineEdit:focus {
    border: 1px solid #87a4c0;
}
QTabBar::tab {
    color: #bfcad6;
    background-color: #252a30;
    border: 1px solid #637587;
    border-bottom: 0px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    padding: 5px 9px;
}
QTabBar::tab:hover {
    color: #edf2f7;
    background-color: #384450;
}
QTabBar::tab:selected {
    color: #f4f7fb;
    background-color: #343b43;
    border-top: 2px solid #7695b2;
}
QTabWidget::pane {
    border: 1px solid #3a444e;
    margin-top: -1px;
}
QHeaderView::section {
    color: #d6dee8;
    background-color: #303740;
    border: 0px;
    border-right: 1px solid #687a8d;
    border-bottom: 1px solid #687a8d;
    padding: 4px 6px;
}
QTreeView, QListView {
    color: #dee5ee;
    background-color: #242a31;
    alternate-background-color: #2b323a;
    selection-background-color: #48617a;
    selection-color: #ffffff;
}
/* Keep project-path and data tables legible on dark panels. */
QTableView, QTableWidget, QTreeWidget {
    color: #e1e8ef;
    background-color: #222930;
    alternate-background-color: #2a323b;
    gridline-color: #424d59;
    selection-color: #ffffff;
    selection-background-color: #496580;
}
QTableView::item, QTableWidget::item, QTreeWidget::item {
    color: #e1e8ef;
}
QTableView::item:selected, QTableWidget::item:selected, QTreeWidget::item:selected {
    color: #ffffff;
    background-color: #496580;
}

QPlainTextEdit, QTextEdit {
    color: #e1e8ef;
    background-color: #20262d;
    selection-background-color: #486a8a;
}
QToolTip {
    color: #f0f4f8;
    background-color: #323b45;
    border: 1px solid #6b7c8c;
    border-radius: 3px;
    padding: 4px;
}
QSplitter::handle:horizontal, QSplitter::handle:vertical {
    background: #667584;
}

/* V2 audit: interactive state and native control improvements */
QComboBox {
    color: #e4eaf1;
    background-color: #323b44;
    border: 1px solid #8497ab;
    border-radius: 3px;
    padding: 3px 4px;
}
QComboBox:focus, QComboBox:hover {
    border: 1px solid #a2bdd6;
}
QComboBox QAbstractItemView {
    color: #e4eaf1;
    background-color: #28313b;
    selection-color: #ffffff;
    selection-background-color: #496580;
}
QSpinBox, QDoubleSpinBox {
    color: #e4eaf1;
    background-color: #252e36;
    border: 1px solid #8296aa;
    border-radius: 2px;
    padding: 2px;
}
QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #a2bdd6;
}
QToolButton:hover {
    background-color: #455365;
    border: 1px solid #9fb5cb;
    border-radius: 3px;
}
QToolButton:focus {
    border: 1px solid #a2bdd6;
}
QCheckBox, QRadioButton {
    color: #e1e8ef;
    spacing: 5px;
}
QGroupBox {
    color: #e3eaf1;
}
QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #849eb8;
}
QScrollBar:vertical, QScrollBar:horizontal {
    border: 1px solid #677988;
}
/* Disabled Project Paths text uses a hardcoded Qt::black pen in Natron C++.
   QSS cannot override it; source-level correction tracked separately. */

/* V3: reduce harsh selected-property outlines and stale orange scrollbar chrome */
NodeSettingsPanel[_selected="true"] {
    border: 1px solid #7695b2;
    border-radius: 2px;
}
NodeSettingsPanel[_selected="false"] {
    border: 1px solid #495665;
    border-radius: 2px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: 1px solid #66798c;
    background-color: #303942;
}
QToolButton {
    border: 1px solid transparent;
    border-radius: 2px;
}
QPushButton:focus, QLineEdit:focus {
    border: 1px solid #b0cde9;
}
QLineEdit:disabled, QLineEdit:read-only {
    color: #b9c4d0;
    background-color: #2b333d;
}
QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    color: #a9b5c1;
    background-color: #2d343c;
    border-color: #566777;
}
QTableView::item:focus, QTreeView::item:focus, QListView::item:focus {
    border: 1px solid #a4c0da;
}
